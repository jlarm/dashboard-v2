includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app
        - config
        - bootstrap
        - database/factories
        - routes

    excludePaths:
        - app/Http/Livewire
        # Job depends on MediaLibrary Pro which was removed in this migration; only callers were Livewire
        - app/Jobs/UploadFinanceAuditImagesJob.php
        # Manual PDF jobs reference Blade views deleted during the manual rewrites; pending follow-up redesign
        - app/Jobs/Manuals/GenerateCmsManualJob.php
        - app/Jobs/Manuals/GenerateIspManualJob.php
        - app/Jobs/Manuals/GenerateOshaManualJob.php
        - app/Jobs/Manuals/GenerateRedFlagManualJob.php

    ignoreErrors:
        -
            identifier: property.notFound
            message: '#ViolationAudit&Illuminate\\Database\\Eloquent\\Model::\$#'
        # Larastan can't infer concrete model from Eloquent Builder/Collection generics.
        # Closures typed with the concrete model are correct at runtime but reject the Model fallback.
        -
            identifier: argument.type
            message: '#expects callable\(Illuminate\\Database\\Eloquent\\Model.*Closure\(App\\Models\\#'
        -
            identifier: argument.type
            message: '#expects callable\(Illuminate\\Database\\Eloquent\\Model.*Closure\(Spatie\\Permission\\Models\\Role#'
        # Paginator::setCollection with mapped (non-Model) collections
        -
            identifier: argument.type
            message: '#setCollection\(\) expects Illuminate\\Support\\Collection<int, (Illuminate\\Database\\Eloquent\\Model|App\\Models\\)#'
        # Collection<int, int> is invariant; Larastan infers tighter int<...,...> ranges that don't unify
        -
            identifier: return.type
            message: '#should return Illuminate\\Support\\Collection<int, int> but returns Illuminate\\Support\\Collection<int, int<#'
