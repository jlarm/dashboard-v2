{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-imagick": "*",
        "aws/aws-sdk-php": "^3.261",
        "barryvdh/laravel-dompdf": "^3.0",
        "doctrine/dbal": "^4.0",
        "filament/forms": "^5.0",
        "filament/notifications": "^5.0",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.33",
        "laravel/nightwatch": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/slack-notification-channel": "^3.2",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.16",
        "league/flysystem-aws-s3-v3": "^3.0",
        "livewire/flux-pro": "^2.13",
        "livewire/livewire": "^4.2",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.27",
        "predis/predis": "^2.3",
        "sentry/sentry-laravel": "^4.3",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-medialibrary": "^11.3",
        "spatie/laravel-permission": "^6.2",
        "spatie/laravel-sluggable": "^3.6",
        "stancl/tenancy": "^3.8",
        "vimeo/laravel": "^5.10",
        "webklex/laravel-pdfmerger": "^1.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4.4",
        "laravel/breeze": "^2.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nunomaduro/phpinsights": "^2.11",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "stubs/shims"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "rector",
            "pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
