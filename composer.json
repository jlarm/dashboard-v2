{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-imagick": "*",
        "aws/aws-sdk-php": "^3.261",
        "barryvdh/laravel-dompdf": "^2.0",
        "doctrine/dbal": "^3.6",
        "filament/forms": "^2.0",
        "filament/notifications": "^2.0",
        "guzzlehttp/guzzle": "^7.5",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/framework": "^9.19",
        "laravel/sanctum": "^3.0",
        "laravel/telescope": "^4.14",
        "laravel/tinker": "^2.7",
        "laravel/vapor-cli": "^1.60",
        "laravel/vapor-core": "^2.33",
        "laravel/vapor-ui": "^1.7",
        "laravel/vonage-notification-channel": "^3.2",
        "livewire/livewire": "^2.11",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.27",
        "sentry/sentry-laravel": "^3.3",
        "spatie/browsershot": "^3.57",
        "spatie/laravel-medialibrary-pro": "^2.0.0",
        "spatie/laravel-onboard": "^2.4",
        "spatie/laravel-permission": "^5.8",
        "spatie/laravel-ray": "^1.32",
        "spatie/laravel-sluggable": "^3.4",
        "stancl/tenancy": "^3.6",
        "vonage/vonage-laravel": "^1.0",
        "webklex/laravel-pdfmerger": "^1.3",
        "wire-elements/pro": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^1.17",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "nunomaduro/phpinsights": "^2.7",
        "pestphp/pest": "^1.22",
        "pestphp/pest-plugin-laravel": "^1.4",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wire-elements-pro.composer.sh"
        },
        {
            "type": "composer",
            "url": "https://satis.spatie.be"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
